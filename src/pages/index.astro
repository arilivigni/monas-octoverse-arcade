---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const title = "Mona’s Octoverse Arcade — Attendee Guide";
const description =
  'Attendee guide for the GitHub Day of Learning 2-hour workshop game challenge: build Mona’s Octoverse Arcade as a Copilot App canvas extension.';

const nav = [
  { href: '#overview', label: 'Overview' },
  { href: '#deliverable', label: 'Deliverable' },
  { href: '#canvas', label: 'Canvas extension' },
  { href: '#prompt', label: 'Prompt' },
  { href: '#agenda', label: 'Agenda' },
  { href: '#judging', label: 'Judging' },
  { href: '#awards', label: 'Awards' },
  { href: '#principles', label: 'Principles' },
  { href: '#themes', label: 'Alt themes' },
  { href: '#checklist', label: 'Demo checklist' },
];

const gameFeatures = [
  { icon: 'commit', title: 'Collect commits', text: 'Mona collects green commit squares.' },
  { icon: 'bug', title: 'Dodge bugs', text: 'Steer clear of the red bugs.' },
  { icon: 'score', title: 'Track the score', text: 'Keep a running score on screen.' },
  { icon: 'speed', title: 'Speed up', text: 'The game gets faster over time.' },
  { icon: 'restart', title: 'Game over & restart', text: 'Show a game-over screen with a restart button.' },
  { icon: 'copilot', title: 'Copilot tips', text: 'Copilot gives an encouraging tip every 10 points.' },
];

const prompt =
  'Build a Copilot App canvas extension called Mona’s Octoverse Arcade. Start from the provided canvas starter template. Inside the canvas, create a game where Mona the Octocat collects green commit-squares while dodging red bugs. Track the score, increase speed over time, and show a game-over screen with a restart button. Copilot appears as a sidekick that gives an encouraging tip every 10 points. The extension must install cleanly and open as a playable canvas. Keep it to HTML/CSS/vanilla JS inside the canvas — no external build step.';

const agenda = [
  { time: '0:00–0:15', minutes: 15, phase: 'Kickoff', detail: 'Demo the target canvas extension, share the idea, the starter prompt, and the rubric.' },
  { time: '0:15–0:25', minutes: 10, phase: 'Install the starter', detail: 'Everyone installs and opens the starter canvas template — confirm it runs.' },
  { time: '0:25–1:15', minutes: 50, phase: 'Build the core game', detail: 'Build the core game inside the canvas with the Copilot App.' },
  { time: '1:15–1:35', minutes: 20, phase: 'Power-up', detail: 'Pick a “power-up” stretch goal: leaderboard, sound, animation, or theming.' },
  { time: '1:35–2:00', minutes: 25, phase: 'Judging', detail: 'Live demos, rubric scoring, and awards decided by the judges. 🏆' },
];

const rubric = [
  { criteria: 'It works', sub: 'installs & runs as a canvas', points: 8, looks: 'Extension installs, canvas opens, game is actually playable.' },
  { criteria: 'Fun factor', sub: '', points: 6, looks: 'Is it enjoyable? Would you play again?' },
  { criteria: 'GitHub theme', sub: '', points: 5, looks: 'Creative use of Mona & Copilot as characters.' },
  { criteria: 'Polish', sub: '', points: 3, looks: 'Visuals, animations, sound, game-over/restart flow.' },
  { criteria: 'Wow / stretch', sub: '', points: 3, looks: 'A power-up feature that surprised the judges.' },
];
const rubricTotal = rubric.reduce((sum, r) => sum + r.points, 0);

const awards = [
  { emoji: '🥇', name: 'Overall Winner', text: 'Best total rubric score across all criteria.' },
  { emoji: '🎨', name: 'Best Design', text: 'The best-looking, most visually striking game (Polish).' },
  { emoji: '🎉', name: 'Most Fun', text: 'The game everyone wanted to keep playing (Fun factor).' },
];

const principles = [
  { title: 'Rubric up front', text: 'Ship the rubric up front so teams build toward what’s judged.' },
  { title: 'Known-good starter', text: 'Provide a known-good canvas starter so “install & run” is achievable for everyone.' },
  { title: 'Reward working software', text: 'The rubric weights “it runs” highest — 8 of 25 points for installing and running as a canvas.' },
  { title: 'Shared theme, personal spin', text: 'Everyone builds Mona’s Arcade, but customizes it.' },
];

const themes = [
  { name: '“Ask Mona” Chatbot', concept: 'A rule-based/scripted Q&A assistant UI.', twist: 'Mona answers Git/GitHub beginner questions; Copilot suggests follow-ups.' },
  { name: 'Commit Streak Tracker', concept: 'A habit/streak tracker.', twist: 'Themed as a “contribution graph” — earn Mona badges for streaks.' },
  { name: 'Octo-Quiz', concept: 'Timed trivia game.', twist: 'Git/GitHub trivia; Copilot gives hints, Mona celebrates wins.' },
  { name: 'PR Review Simulator', concept: 'Card-swipe game (approve/request changes).', twist: 'Learn code-review etiquette; Mona is the author, Copilot the reviewer.' },
  { name: 'Mona’s Sticker Maker', concept: 'Canvas drawing + Octocat generator.', twist: 'Compose your own Octocat; export as PNG.' },
];

const checklist = [
  'Your extension lives in its own folder with an extension.mjs that registers a canvas.',
  'It installs cleanly into the Copilot App (install_extension from a gist or repo folder, or dropped into the extensions directory).',
  'It opens with open_canvas and the game renders in the side panel.',
  'Mona collects green commit squares and dodges red bugs.',
  'The score is tracked and the speed increases over time.',
  'A game-over screen appears with a working restart button.',
  'Copilot pops in with an encouraging tip every 10 points.',
  'Everything is HTML/CSS/vanilla JS inside the canvas — no external build step.',
  'Your power-up stretch feature is ready to show off.',
  'You’ve rehearsed a 90-second demo: install live, play it, show it running as a canvas.',
];
---

<Base title={title} description={description}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="#top" aria-label="Mona’s Octoverse Arcade — back to top">
        <img src={`${base}favicon.svg`} alt="" width="32" height="32" />
        <span>Mona’s <strong>Octoverse Arcade</strong></span>
      </a>
      <nav aria-label="Sections">
        <ul class="nav-list">
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">GitHub Day of Learning · 2-hour workshop game challenge</p>
          <h1 id="hero-title">
            <span class="title-small">Mona’s</span>
            <span class="title-big">Octoverse Arcade</span>
          </h1>
          <p class="edition"><span class="pill pill-purple">Canvas Extension Edition</span></p>
          <p class="lede">
            Build a browser game starring <strong>Mona</strong> the Octocat as the hero and <strong>Copilot</strong> as
            the sidekick — and ship it as a <strong>Copilot App canvas extension</strong> that installs and runs inside
            the Copilot App. At the end, we judge every submission and crown a winner.
          </p>
          <ul class="stats" aria-label="At a glance">
            <li><span class="stat-num">2</span><span class="stat-label">hours</span></li>
            <li><span class="stat-num">25</span><span class="stat-label">rubric points</span></li>
            <li><span class="stat-num">3</span><span class="stat-label">award categories</span></li>
            <li><span class="stat-num">90s</span><span class="stat-label">live demos</span></li>
          </ul>
          <div class="cta-row">
            <a class="btn btn-primary" href="#overview">Read the challenge</a>
            <a class="btn btn-ghost" href="#prompt">Get the starter prompt</a>
          </div>
        </div>
        <figure class="hero-art">
          <img
            src={`${base}images/hero-arcade.svg`}
            width="1030"
            height="540"
            alt="Original tile-grid illustration in GitHub-green, neutral, and Copilot-purple colors: Mona beside a green curly brace, a purple Copilot robot sidekick, a git branch line, monospace words “ship”, “play”, and “commit”, red pixel bugs and green commit squares, a terminal prompt, and a contribution-graph pixel pattern."
          />
        </figure>
      </div>
    </section>

    <section id="overview" class="section" aria-labelledby="overview-title">
      <div class="container">
        <p class="kicker">01 · Challenge overview</p>
        <h2 id="overview-title">The game you’ll build</h2>
        <p class="section-intro">
          Every team builds the same core arcade game, then adds its own spin. Here’s what the core game needs to do:
        </p>
        <ul class="feature-grid">
          {gameFeatures.map((f) => (
            <li class="card feature">
              <span class={`feature-icon icon-${f.icon}`} aria-hidden="true"></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="deliverable" class="section section-alt" aria-labelledby="deliverable-title">
      <div class="container two-col">
        <div>
          <p class="kicker">02 · Goal &amp; deliverable</p>
          <h2 id="deliverable-title">Ship it as a canvas extension</h2>
          <p>
            The game can’t just be a loose HTML file. Your deliverable is a <strong>Copilot App canvas extension</strong>
            that can be installed and launched inside the Copilot App itself.
          </p>
          <p>
            <strong>Why this raises the bar (in a good way):</strong> you learn the real extension model — manifest,
            canvas registration, install, and launch — not just front-end code. It’s the “GitHub twist” that makes the
            challenge platform-native.
          </p>
        </div>
        <ol class="flow" aria-label="Deliverable flow">
          <li><span class="flow-step">Build</span><span>A playable game inside a canvas</span></li>
          <li><span class="flow-step">Install</span><span>Into the Copilot App</span></li>
          <li><span class="flow-step">Open</span><span>Playable in the side panel</span></li>
        </ol>
      </div>
    </section>

    <section id="canvas" class="section" aria-labelledby="canvas-title">
      <div class="container">
        <p class="kicker">03 · Core requirement</p>
        <h2 id="canvas-title">Canvas extension requirements</h2>
        <p class="section-intro">Your game must be a Copilot canvas extension that:</p>
        <ol class="req-list">
          <li class="card">
            <span class="req-num" aria-hidden="true">1</span>
            <div>
              <h3>Lives in its own folder</h3>
              <p>With an <code>extension.mjs</code> that <strong>registers a canvas</strong> (the game UI).</p>
            </div>
          </li>
          <li class="card">
            <span class="req-num" aria-hidden="true">2</span>
            <div>
              <h3>Can be installed</h3>
              <p>
                Into the Copilot App — via <code>install_extension</code> from a GitHub gist or repo folder, or dropped
                into the extensions directory.
              </p>
            </div>
          </li>
          <li class="card">
            <span class="req-num" aria-hidden="true">3</span>
            <div>
              <h3>Runs as a canvas</h3>
              <p>
                When the agent opens it with <code>open_canvas</code>, the game renders in the side panel and is
                playable.
              </p>
            </div>
          </li>
        </ol>
        <div class="callout">
          <p>
            <strong>Start from the provided canvas starter template.</strong> Build the game UI with HTML, CSS, and
            vanilla JavaScript inside the canvas — no external build step.
          </p>
        </div>
      </div>
    </section>

    <section id="prompt" class="section section-alt" aria-labelledby="prompt-title">
      <div class="container">
        <p class="kicker">04 · Participant prompt</p>
        <h2 id="prompt-title">Your initial prompt</h2>
        <p class="section-intro">Paste this into the Copilot App to get started, then make it your own.</p>
        <figure class="prompt-card">
          <div class="prompt-bar">
            <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="prompt-label">starter-prompt.txt</span>
            <button type="button" class="btn btn-small" id="copy-prompt" hidden>Copy prompt</button>
          </div>
          <blockquote id="prompt-text"><p>{prompt}</p></blockquote>
          <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
        </figure>
      </div>
    </section>

    <section id="agenda" class="section" aria-labelledby="agenda-title">
      <div class="container">
        <p class="kicker">05 · Timed agenda</p>
        <h2 id="agenda-title">Two hours, five phases</h2>
        <ol class="timeline">
          {agenda.map((a) => (
            <li class="timeline-item" style={`--minutes:${a.minutes}`}>
              <div class="timeline-time">
                <span class="time">{a.time}</span>
                <span class="duration">{a.minutes} min</span>
              </div>
              <div class="timeline-body">
                <h3>{a.phase}</h3>
                <p>{a.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="judging" class="section section-alt" aria-labelledby="judging-title">
      <div class="container">
        <p class="kicker">06 · Judging</p>
        <h2 id="judging-title">Scoring rubric ({rubricTotal} points total)</h2>
        <p class="section-intro">
          <strong>Demo format:</strong> in the final block (1:35–2:00), each team installs its extension live and gives
          a <strong>90-second demo</strong> — play it and show it running as a canvas. Judges score each demo against the rubric.
        </p>
        <div class="table-wrap">
          <table class="rubric">
            <caption class="visually-hidden">Scoring rubric, {rubricTotal} points total</caption>
            <thead>
              <tr>
                <th scope="col">Criteria</th>
                <th scope="col" class="num">Points</th>
                <th scope="col">What judges look for</th>
              </tr>
            </thead>
            <tbody>
              {rubric.map((r) => (
                <tr>
                  <th scope="row">
                    {r.criteria}
                    {r.sub && <span class="sub"> — {r.sub}</span>}
                  </th>
                  <td class="num">
                    <span class="pts-cell">
                      <span class="points">{r.points}</span>
                      <span class="bar" aria-hidden="true" style={`--pts:${r.points}`}></span>
                    </span>
                  </td>
                  <td>{r.looks}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Total</th>
                <td class="num"><span class="points">{rubricTotal}</span></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <section id="awards" class="section" aria-labelledby="awards-title">
      <div class="container">
        <p class="kicker">07 · Awards</p>
        <h2 id="awards-title">Three ways to win</h2>
        <p class="section-intro">The <strong>judges decide</strong> all three categories. Each category winner takes home <strong>swag</strong> 🎁.</p>
        <ul class="award-grid">
          {awards.map((a) => (
            <li class="card award">
              <span class="award-emoji" aria-hidden="true">{a.emoji}</span>
              <h3>{a.name}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>
        <div class="callout callout-purple">
          <p>
            <strong>Tie &amp; rollover rule:</strong> a team can win more than one category, but if the Overall Winner
            also tops another category, that second award rolls to the runner-up to spread the recognition.
          </p>
        </div>
      </div>
    </section>

    <section id="principles" class="section section-alt" aria-labelledby="principles-title">
      <div class="container">
        <p class="kicker">08 · Design principles</p>
        <h2 id="principles-title">How this challenge is designed</h2>
        <ul class="principle-grid">
          {principles.map((p) => (
            <li class="card principle">
              <span class="check" aria-hidden="true">✓</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="themes" class="section" aria-labelledby="themes-title">
      <div class="container">
        <p class="kicker">09 · Alternate themes</p>
        <h2 id="themes-title">Alternate theme options</h2>
        <p class="section-intro">Same format and same rubric — just a different idea.</p>
        <ul class="theme-grid">
          {themes.map((t) => (
            <li class="card theme">
              <h3>{t.name}</h3>
              <dl>
                <dt>Concept</dt>
                <dd>{t.concept}</dd>
                <dt>GitHub twist</dt>
                <dd>{t.twist}</dd>
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="checklist" class="section section-alt" aria-labelledby="checklist-title">
      <div class="container">
        <p class="kicker">10 · Before you demo</p>
        <h2 id="checklist-title">Quick demo checklist</h2>
        <p class="section-intro">Tick these off before your 90 seconds in the spotlight.</p>
        <ul class="checklist">
          {checklist.map((item, i) => (
            <li>
              <input type="checkbox" id={`check-${i}`} />
              <label for={`check-${i}`}>{item}</label>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-title">Mona’s Octoverse Arcade · Canvas Extension Edition</p>
      <p>
        An independent workshop resource for a GitHub Day of Learning session. This is not an official GitHub Universe
        or GitHub event website and is not endorsed by GitHub. GitHub, GitHub Copilot, and the Octocat are trademarks of
        GitHub, Inc. Character artwork on this site is original, Octocat-inspired workshop illustration.
      </p>
      <p><a href="#top">Back to top ↑</a></p>
    </div>
  </footer>

  <script>
    const button = document.getElementById('copy-prompt');
    const text = document.getElementById('prompt-text');
    const status = document.getElementById('copy-status');
    if (button && text && status && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text.innerText.trim());
          status.textContent = 'Prompt copied to clipboard.';
        } catch {
          status.textContent = 'Copy failed — select the text and copy it manually.';
        }
      });
    }
  </script>
</Base>
