---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const title = "Mona’s Octoverse Arcade — Attendee Guide";
const description =
  'Attendee guide for the GitHub Day of Learning 2-hour workshop game challenge: build Mona’s Octoverse Arcade as a Copilot App canvas extension.';

const nav = [
  { href: '#prompt', label: 'Prompt' },
  { href: '#teams', label: 'Teams' },
  { href: '#canvas', label: 'Canvas extension' },
  { href: '#agenda', label: 'Agenda' },
  { href: '#submit', label: 'Submit' },
  { href: '#judging', label: 'Judging' },
  { href: '#awards', label: 'Awards' },
  { href: '#principles', label: 'Principles' },
  { href: '#themes', label: 'Future ideas' },
];

const baseline = [
  'Mona collects green commit squares and dodges red bugs.',
  'The score is tracked, and the speed increases over time.',
  'A game-over screen has a restart button.',
  'Copilot cheers you on with a tip every 10 points.',
];

const spins = [
  { title: 'Rethink the world', text: 'Levels, settings, and a story that make Mona’s arcade feel like yours.' },
  { title: 'Invent power-ups', text: 'Shields, magnets, merge combos, or boss bugs. Surprise the judges.' },
  { title: 'Give Copilot personality', text: 'Make the sidekick funny, helpful, or full of surprises.' },
  { title: 'Find your style', text: 'Art direction, animation, and sound that make people want to keep playing.' },
];

const teamRules = [
  { value: '4–6', title: 'People per team', text: 'Minimum 4, maximum 6. Aim for 5.' },
  { value: 'Name', title: 'Choose a team name', text: 'Pick it during kickoff. You’ll use it on your submission.' },
  { value: '1', title: 'Shared repository', text: 'Keep your team’s extension in one repository that judges can open.' },
];

const submission = [
  { title: 'Team name', text: 'The name your team chose at kickoff.' },
  { title: 'Description', text: 'A few sentences about your game, your creative spin, and your power-up.' },
  { title: 'Demo video', text: 'Up to 90 seconds. Install the extension, open it as a canvas, and play. Attach the video to your comment or add a link.' },
  { title: 'Repository link', text: 'The repository that contains your extension folder. Make sure the judges can access it.' },
];

const prompt =
  'Build a Copilot App canvas extension called Mona’s Octoverse Arcade. Start from the provided canvas starter template. Inside the canvas, create a game where Mona the Octocat collects green commit-squares while dodging red bugs. Track the score, increase speed over time, and show a game-over screen with a restart button. Copilot appears as a sidekick that gives an encouraging tip every 10 points. The extension must install cleanly and open as a playable canvas. Keep it to HTML/CSS/vanilla JS inside the canvas — no external build step.';

const agenda = [
  { time: '0:00–0:15', minutes: 15, phase: 'Kickoff & teams', detail: 'See the target canvas extension, get the starter prompt and rubric, form teams of 4–6, and choose a team name.' },
  { time: '0:15–0:25', minutes: 10, phase: 'Install the starter', detail: 'Every team installs and opens the starter canvas template — confirm it runs.' },
  { time: '0:25–1:15', minutes: 50, phase: 'Build your game', detail: 'Start from the prompt, then build your team’s version inside the canvas with the Copilot App.' },
  { time: '1:15–1:35', minutes: 20, phase: 'Power-up', detail: 'Pick a “power-up” stretch goal: leaderboard, sound, animation, theming, or your own idea.' },
  { time: '1:35–2:00', minutes: 25, phase: 'Record & submit', detail: 'Record a demo video of up to 90 seconds and post your submission in the challenge Discussion before the workshop ends. 🏆' },
];

const rubric = [
  { criteria: 'It works', sub: 'installs & runs as a canvas', points: 8, looks: 'Extension installs, canvas opens, game is actually playable.' },
  { criteria: 'Fun factor', sub: '', points: 6, looks: 'Is it enjoyable? Would you play again?' },
  { criteria: 'GitHub theme', sub: '', points: 5, looks: 'Creative use of Mona & Copilot as characters.' },
  { criteria: 'Polish', sub: '', points: 3, looks: 'Visuals, animations, sound, game-over/restart flow.' },
  { criteria: 'Wow / stretch', sub: '', points: 3, looks: 'A power-up feature that surprised the judges.' },
];
const rubricTotal = rubric.reduce((sum, r) => sum + r.points, 0);

const awards = [
  { emoji: '🥇', name: 'Overall Winner', text: 'Best total rubric score across all criteria.' },
  { emoji: '🎨', name: 'Best Design', text: 'The best-looking, most visually striking game (Polish).' },
  { emoji: '🎉', name: 'Most Fun', text: 'The game the judges most wanted to keep playing (Fun factor).' },
];

const principles = [
  { title: 'Rubric up front', text: 'Ship the rubric up front so teams build toward what’s judged.' },
  { title: 'Known-good starter', text: 'Provide a known-good canvas starter so “install & run” is achievable for everyone.' },
  { title: 'Reward working software', text: 'The rubric weights “it runs” highest — 8 of 25 points for installing and running as a canvas.' },
  { title: 'Shared theme, personal spin', text: 'Every team starts from the same prompt and builds Mona’s Arcade, then makes it its own.' },
];

const themes = [
  { name: '“Ask Mona” Chatbot', concept: 'A rule-based/scripted Q&A assistant UI.', twist: 'Mona answers Git/GitHub beginner questions; Copilot suggests follow-ups.' },
  { name: 'Commit Streak Tracker', concept: 'A habit/streak tracker.', twist: 'Themed as a “contribution graph” — earn Mona badges for streaks.' },
  { name: 'Octo-Quiz', concept: 'Timed trivia game.', twist: 'Git/GitHub trivia; Copilot gives hints, Mona celebrates wins.' },
  { name: 'PR Review Simulator', concept: 'Card-swipe game (approve/request changes).', twist: 'Learn code-review etiquette; Mona is the author, Copilot the reviewer.' },
  { name: 'Mona’s Sticker Maker', concept: 'Canvas drawing + Octocat generator.', twist: 'Compose your own Octocat; export as PNG.' },
];
---

<Base title={title} description={description}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="#top" aria-label="Mona’s Octoverse Arcade — back to top">
        <span class="arcade-mark" aria-hidden="true">+</span>
        <span>Mona’s <strong>Octoverse Arcade</strong></span>
      </a>
      <nav aria-label="Sections">
        <ul class="nav-list">
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="hero-heading">
          <p class="eyebrow">GitHub Day of Learning · 2-hour workshop game challenge</p>
          <h1 id="hero-title">
            <span class="title-small">Mona’s</span>
            <span class="title-big">Octoverse Arcade</span>
          </h1>
          <p class="edition"><span class="pill pill-purple">Canvas Extension Edition</span></p>
          </div>
          <div class="hero-summary">
          <p class="lede">
            Build a browser game starring <strong>Mona</strong> the Octocat as the hero and <strong>Copilot</strong> as
            the sidekick, then ship it as a <strong>Copilot App canvas extension</strong>. Every team starts from one
            prompt. What you build from it is up to you.
          </p>
          <ul class="stats" aria-label="At a glance">
            <li><span class="stat-num">2</span><span class="stat-label">hours</span></li>
            <li><span class="stat-num">4–6</span><span class="stat-label">people per team</span></li>
            <li><span class="stat-num">25</span><span class="stat-label">rubric points</span></li>
            <li><span class="stat-num">3</span><span class="stat-label">award categories</span></li>
          </ul>
          <div class="cta-row">
            <a class="btn btn-primary" href="#prompt">Get the starter prompt</a>
            <a class="btn btn-ghost" href="#teams">Form your team</a>
          </div>
          </div>
        </div>
        <figure class="hero-art">
          <img
            src={`${base}images/arcade-hero.png`}
            width="2000"
            height="778"
            fetchpriority="high"
            alt="Mona perched on green blocks beneath a white sprout, surrounded by pastel clouds and a blue sky."
          />
        </figure>
      </div>
    </section>

    <section id="prompt" class="section section-prompt" aria-labelledby="prompt-title">
      <div class="container">
        <p class="kicker">01 · Start here</p>
        <h2 id="prompt-title">One prompt. Your game.</h2>
        <p class="section-intro">
          Every team starts with this prompt in the Copilot App. It sets the baseline, not the limit. Build what it asks,
          then take the game somewhere only your team would.
        </p>
        <figure class="prompt-card prompt-feature">
          <div class="prompt-bar">
            <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
            <span class="prompt-label">starter-prompt.txt</span>
            <button type="button" class="btn btn-small" id="copy-prompt" hidden>Copy prompt</button>
          </div>
          <blockquote id="prompt-text"><p>{prompt}</p></blockquote>
          <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
        </figure>
        <div class="prompt-extras">
          <div class="baseline">
            <h3>The baseline</h3>
            <ul>
              {baseline.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3>Make it yours</h3>
            <ul class="spin-grid">
              {spins.map((s) => (
                <li class="card">
                  <h4>{s.title}</h4>
                  <p>{s.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="teams" class="section section-alt" aria-labelledby="teams-title">
      <div class="container">
        <p class="kicker">02 · Teams</p>
        <h2 id="teams-title">Build as a team</h2>
        <p class="section-intro">
          Up to 150 people may take part, so everyone builds in a team. Form your team and choose a team name during
          kickoff.
        </p>
        <ul class="team-grid">
          {teamRules.map((t) => (
            <li class="card team-card">
              <span class="team-value" aria-hidden="true">{t.value}</span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))}
        </ul>
        <div class="callout">
          <p>
            <strong>Planning numbers:</strong> with 150 participants, teams of 5 make about 30 teams (25–38, depending on
            team size). If your group has fewer than 4 people, join another group. If it has more than 6, split into two
            teams.
          </p>
        </div>
      </div>
    </section>

    <section id="canvas" class="section" aria-labelledby="canvas-title">
      <div class="container">
        <p class="kicker">03 · Core requirement</p>
        <h2 id="canvas-title">Ship it as a canvas extension</h2>
        <p class="section-intro">
          Your game can’t be a loose HTML file. It must be a <strong>Copilot App canvas extension</strong> that:
        </p>
        <ol class="req-list">
          <li class="card">
            <span class="req-num" aria-hidden="true">1</span>
            <div>
              <h3>Lives in its own folder</h3>
              <p>With an <code>extension.mjs</code> that <strong>registers a canvas</strong> (the game UI).</p>
            </div>
          </li>
          <li class="card">
            <span class="req-num" aria-hidden="true">2</span>
            <div>
              <h3>Can be installed</h3>
              <p>
                Into the Copilot App — via <code>install_extension</code> from a GitHub gist or repo folder, or dropped
                into the extensions directory.
              </p>
            </div>
          </li>
          <li class="card">
            <span class="req-num" aria-hidden="true">3</span>
            <div>
              <h3>Runs as a canvas</h3>
              <p>
                When the agent opens it with <code>open_canvas</code>, the game renders in the side panel and is
                playable.
              </p>
            </div>
          </li>
        </ol>
        <div class="callout">
          <p>
            <strong>Start from the provided canvas starter template.</strong> Build the game UI with HTML, CSS, and
            vanilla JavaScript inside the canvas — no external build step. You’ll learn the real extension model:
            manifest, canvas registration, install, and launch. That’s the “GitHub twist” that makes the challenge
            platform-native.
          </p>
        </div>
      </div>
    </section>

    <section id="agenda" class="section section-alt" aria-labelledby="agenda-title">
      <div class="container">
        <p class="kicker">04 · Timed agenda</p>
        <h2 id="agenda-title">Two hours, five phases</h2>
        <ol class="timeline">
          {agenda.map((a) => (
            <li class="timeline-item" style={`--minutes:${a.minutes}`}>
              <div class="timeline-time">
                <span class="time">{a.time}</span>
                <span class="duration">{a.minutes} min</span>
              </div>
              <div class="timeline-body">
                <h3>{a.phase}</h3>
                <p>{a.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="submit" class="section" aria-labelledby="submit-title">
      <div class="container">
        <p class="kicker">05 · Submit</p>
        <h2 id="submit-title">Submit in the challenge Discussion</h2>
        <p class="section-intro">
          Before the workshop ends at 2:00, one teammate posts your team’s submission as a single comment in the
          challenge Discussion. Your facilitator will share the link. Include:
        </p>
        <ol class="req-list submit-list">
          {submission.map((item, i) => (
            <li class="card">
              <span class="req-num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="judging" class="section section-alt" aria-labelledby="judging-title">
      <div class="container">
        <p class="kicker">06 · Judging</p>
        <h2 id="judging-title">Scoring rubric ({rubricTotal} points total)</h2>
        <p class="section-intro">
          <strong>How judging works:</strong> after the workshop, judges review every submission’s demo video and
          repository against the 25-point rubric. They choose all three award winners and announce them in the challenge
          Discussion. There is no audience vote.
        </p>
        <div class="table-wrap">
          <table class="rubric">
            <caption class="visually-hidden">Scoring rubric, {rubricTotal} points total</caption>
            <thead>
              <tr>
                <th scope="col">Criteria</th>
                <th scope="col" class="num">Points</th>
                <th scope="col">What judges look for</th>
              </tr>
            </thead>
            <tbody>
              {rubric.map((r) => (
                <tr>
                  <th scope="row">
                    {r.criteria}
                    {r.sub && <span class="sub"> — {r.sub}</span>}
                  </th>
                  <td class="num">
                    <span class="pts-cell">
                      <span class="points">{r.points}</span>
                      <span class="bar" aria-hidden="true" style={`--pts:${r.points}`}></span>
                    </span>
                  </td>
                  <td>{r.looks}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Total</th>
                <td class="num"><span class="points">{rubricTotal}</span></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <section id="awards" class="section" aria-labelledby="awards-title">
      <div class="container">
        <p class="kicker">07 · Awards</p>
        <h2 id="awards-title">Three ways to win</h2>
        <p class="section-intro">The <strong>judges decide</strong> all three categories. Each category winner takes home <strong>swag</strong> 🎁.</p>
        <ul class="award-grid">
          {awards.map((a) => (
            <li class="card award">
              <span class="award-emoji" aria-hidden="true">{a.emoji}</span>
              <h3>{a.name}</h3>
              <p>{a.text}</p>
            </li>
          ))}
        </ul>
        <div class="callout callout-purple">
          <p>
            <strong>Award rollover rule:</strong> a team can win more than one category, but if the Overall Winner
            also tops another category, that second award rolls to the runner-up to spread the recognition.
          </p>
        </div>
      </div>
    </section>

    <section id="principles" class="section section-alt" aria-labelledby="principles-title">
      <div class="container">
        <p class="kicker">08 · Design principles</p>
        <h2 id="principles-title">How this challenge is designed</h2>
        <ul class="principle-grid">
          {principles.map((p) => (
            <li class="card principle">
              <span class="check" aria-hidden="true">✓</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="themes" class="section" aria-labelledby="themes-title">
      <div class="container">
        <p class="kicker">09 · Beyond the workshop</p>
        <h2 id="themes-title">Ideas for your next canvas extension</h2>
        <p class="section-intro">
          Inspiration for after the workshop — not submissions for this competition. Every team builds Mona’s Arcade
          for this challenge, with the shared gameplay requirements and 25-point rubric.
        </p>
        <ul class="theme-grid">
          {themes.map((t) => (
            <li class="card theme">
              <h3>{t.name}</h3>
              <dl>
                <dt>Concept</dt>
                <dd>{t.concept}</dd>
                <dt>GitHub twist</dt>
                <dd>{t.twist}</dd>
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section-alt arcade-showcase" aria-labelledby="arcade-showcase-title">
      <div class="container">
        <div class="showcase-heading">
          <div>
            <p class="kicker">Built with imagination</p>
            <h2 id="arcade-showcase-title">One Mona. Endless possibilities.</h2>
          </div>
          <p class="section-intro">Bring your own creative spin to the arcade. Keep Mona at the heart of the game, and make something worth playing again.</p>
        </div>
        <div class="artwork-grid">
          <figure class="artwork-panel">
            <img src={`${base}images/universe-2026.png`} width="1200" height="630" loading="lazy"
              alt="GitHub Universe ’26 artwork with Mona and colorful silhouettes. The original event lockup reads October 2026, San Francisco, CA." />
            <figcaption>Universe ’26 · Supplied event artwork, not workshop event details.</figcaption>
            <img class="artwork-pattern" src={`${base}images/pattern-green-pink.png`} width="534" height="288" loading="lazy" alt="" />
          </figure>
          <figure class="artwork-panel">
            <img src={`${base}images/mona-clouds.png`} width="1200" height="630" loading="lazy"
              alt="Mona looking toward a glowing white butterfly, surrounded by pastel clouds against a blue sky." />
            <figcaption>A little curiosity. A whole new world to build.</figcaption>
            <img class="artwork-pattern" src={`${base}images/pattern-gold-orange.png`} width="522" height="296" loading="lazy" alt="" />
          </figure>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p class="footer-title">Mona’s Octoverse Arcade · Canvas Extension Edition</p>
      <p>
        An independent workshop resource for a GitHub Day of Learning session. This is not an official GitHub Universe
        or GitHub event website and is not endorsed by GitHub. GitHub, GitHub Copilot, and the Octocat are trademarks of
        GitHub, Inc. Supplied GitHub artwork is displayed unaltered. Universe event details shown in that artwork
        are not the workshop’s event details.
      </p>
      <p><a href="#top">Back to top ↑</a></p>
    </div>
  </footer>

  <script>
    const button = document.getElementById('copy-prompt');
    const text = document.getElementById('prompt-text');
    const status = document.getElementById('copy-status');
    if (button && text && status && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text.innerText.trim());
          status.textContent = 'Prompt copied to clipboard.';
        } catch {
          status.textContent = 'Copy failed — select the text and copy it manually.';
        }
      });
    }
  </script>
</Base>
